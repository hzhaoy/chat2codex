# Platform selector. Omit it to preserve the historical Feishu default.
CHAT2CODEX_ADAPTER=feishu

# Run `chat2codex setup --workdir /absolute/path/to/your/repo` to create
# and connect a Feishu/Lark app automatically,
# or fill these manually from the Feishu/Lark developer console.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
# Written by setup when available. Used to ignore group messages that do not
# explicitly mention this bot.
FEISHU_BOT_OPEN_ID=

# Use "feishu" for 飞书, "lark" for Lark global.
LARK_DOMAIN=feishu

# `chat2codex setup weixin` stores the ClawBot Token in this private JSON file,
# never in .env. Leave empty to use ~/.chat2codex/weixin/credentials.json.
WEIXIN_CREDENTIALS_PATH=

# The directory Codex should work in by default.
CODEX_WORKDIR=/absolute/path/to/your/repo
# Foreground development can use `codex`. For the most reliable background
# service setup, replace it with an absolute path from `command -v codex`.
CODEX_BIN=codex
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
# 0 disables automatic timeout. Set positive values for unattended team bots.
CODEX_RUN_TIMEOUT_MS=0
CODEX_APPROVAL_TIMEOUT_MS=0
CODEX_MAX_CONCURRENT_RUNS=2
# Idle app-server sessions keep session-scoped grants in memory. Set 0 to
# disable idle eviction. The session cap must be at least the run concurrency.
CODEX_APP_SERVER_IDLE_TTL_MS=900000
CODEX_MAX_APP_SERVER_SESSIONS=8
CODEX_MODEL=
CODEX_SKIP_GIT_REPO_CHECK=false
# Group chats are constrained to CODEX_WORKDIR unless this comma-separated list is set.
# Direct messages are not constrained by this setting.
CODEX_GROUP_ALLOWED_ROOTS=

# Access control. Direct routing is enabled by default, but a direct chat or
# sender must be explicitly allowlisted. Groups require both chat and sender
# allowlists. `chat2codex setup` adds the scanning user's open_id automatically.
ALLOW_DIRECT_MESSAGES=true
ALLOW_GROUPS=false
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=

# Resource and retention limits. All values must be positive integers. Pending
# limits cover active jobs, undelivered replies, pending control messages, and
# in-turn approval/input waits.
BRIDGE_MAX_PENDING_MESSAGES=64
BRIDGE_MAX_PENDING_MESSAGES_PER_CHAT=8

ATTACHMENT_DOWNLOAD_DIR=.data/attachments
ATTACHMENT_MAX_COUNT=4
ATTACHMENT_MAX_FILE_BYTES=26214400
ATTACHMENT_MAX_TOTAL_BYTES=52428800
ATTACHMENT_STORE_MAX_BYTES=1073741824
ATTACHMENT_RETENTION_HOURS=24
CHAT_OUTPUT_MAX_CHARS=28000
CODEX_STDERR_MAX_BYTES=262144
RUN_LOG_MAX_COMMANDS=20
RUN_LOG_MAX_BYTES=65536
RUN_DIFF_MAX_CHARS=60000
LOG_ENTRY_MAX_BYTES=16384
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_MAX_FILES=3
JOB_RETENTION_COUNT=500
OUTBOX_RETENTION_COUNT=500
BRIDGE_STATE_PATH=.data/state.json
LOG_LEVEL=info
